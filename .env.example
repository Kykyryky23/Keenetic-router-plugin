# LAN-адрес роутера (без схемы/порта), например 192.168.23.1
ROUTER_HOST=192.168.23.1
ROUTER_PORT=80
ROUTER_LOGIN=change_me
ROUTER_PASSWORD=change_me

# Разрешить деструктивные операции (reboot, factory-reset, firmware-update).
# По умолчанию выключено — сервер отклоняет такие вызовы, даже если ИИ их запросит.
ALLOW_DESTRUCTIVE=false

# Путь к аудит-логу write/destructive вызовов
AUDIT_LOG_PATH=./audit.log
